# Copy to .env and adjust. Only POSTGRES_PASSWORD is required; everything else has a default.

# Required. Postgres reads it only when the volume is first created (see README to change it).
POSTGRES_PASSWORD=

# Image to run. Pin a release (e.g. ghcr.io/taowatch/validators:1.2.0) or a commit (:sha-abc1234).
IMAGE=ghcr.io/taowatch/validators:latest

# Where the web/API port is published. Keep 127.0.0.1 behind a reverse proxy.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Live node for head snapshots; archive nodes for backfill (comma-separated, rotated on failure).
RPC_URLS=wss://entrypoint-finney.opentensor.ai:443
ARCHIVE_URLS=wss://bittensor-finney.api.onfinality.io/public-ws,wss://archive.chain.opentensor.ai:443

# Snapshot cadence in seconds.
INTERVAL_SECS=3600
# Days of daily history to backfill from the archive node.
BACKFILL_DAYS=30
# Days of history kept (never less than BACKFILL_DAYS + 2). Lowering BACKFILL_DAYS keeps history.
KEEP_DAYS=400
# Track alpha pools of delegates holding at least this much alpha.
MIN_ALPHA=100
# Hourly samples kept; older ones are thinned to one per UTC day.
KEEP_HOURS=72
# Refresh nominator counts every N cycles.
NOMINATORS_EVERY=24

RUST_LOG=info
